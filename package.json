{
  "name": "consensus-bets",
  "version": "1.0.0",
  "description": "Read-only dashboard of consensus bets among Polymarket's top traders, with matching Kalshi prices.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "refresh": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/refresh.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  }
}
